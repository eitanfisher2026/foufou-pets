rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'regular';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isEditorOrAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'editor');
    }

    // Settings (where roles get managed) is admin-only, which means nobody
    // could ever reach it to grant the very first admin - one known
    // identity is allowed to create its own profile doc as admin instead
    // of regular, mirroring the same check in usersApi.js. Everyone else
    // always starts REGULAR; only an existing admin can promote anyone
    // after that.
    function isBootstrapAdmin() {
      return request.auth.token.email == 'eitanfisher100@gmail.com';
    }

    // Everyone who has ever signed in gets a profile doc (see usersApi.js:
    // upsertUserOnLogin). Only an admin can change someone's role after
    // creation; a user can still update their own doc (lastLoginAt,
    // refreshed displayName/photoURL on each sign-in) as long as they
    // leave role untouched.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid &&
        (request.resource.data.role == 'regular' || (request.resource.data.role == 'admin' && isBootstrapAdmin()));
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Everyone can view every case (regular users included - "view all
    // records" is explicit) and create their own. Editing/deleting someone
    // else's case is editor/admin-only, with two narrow carve-outs:
    // - matchCount/newMatchCount/importantMatchCount/topMatchScore/
    //   lastCheckedAt/visualMatchCostUsd/hasVisualMatch are pure
    //   denormalized counters recomputed FROM this case's own /matches
    //   subcollection below (which is itself properly access-controlled) -
    //   low-sensitivity derived data, kept open to any signed-in user so
    //   "run matches" from the OTHER side of a pairing (a found report you
    //   own, being checked against lost cases you don't) can still refresh
    //   the summary numbers on cases you're not the owner of.
    // - status/closureDate/closureReason/closedBy/closingComment/
    //   closedViaFoundReportId/updatedAt ONLY when closureReason is
    //   'system_match_closed' (see updateMatchStatus in matchingApi.js) AND
    //   a real match naming that exact found report exists under this exact
    //   case AND the requester actually owns that found report - so
    //   marking a match CLOSED (a genuine "found!") can archive both sides
    //   even when the closer only owns one of them, without opening this
    //   case's status to anyone who merely claims a found report as theirs.
    match /lostCases/{caseId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isEditorOrAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'matchCount', 'newMatchCount', 'importantMatchCount', 'topMatchScore',
          'lastCheckedAt', 'visualMatchCostUsd', 'hasVisualMatch'
        ]) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'closureDate', 'closureReason', 'closedBy', 'closingComment',
            'closedViaFoundReportId', 'updatedAt'
          ]) &&
          request.resource.data.closureReason == 'system_match_closed' &&
          exists(/databases/$(database)/documents/lostCases/$(caseId)/matches/$(request.resource.data.closedViaFoundReportId)) &&
          get(/databases/$(database)/documents/foundReports/$(request.resource.data.closedViaFoundReportId)).data.reportedByUid == request.auth.uid
        )
      );
      allow delete: if signedIn() && (isEditorOrAdmin() || resource.data.ownerId == request.auth.uid);

      // A match can be written by whoever owns EITHER side of this exact
      // pairing (this case, or the found report named by this subcollection
      // doc's own id) - or an editor/admin. Tightened from "any signed-in
      // user" so running matches, reviewing a match's status, and closing
      // one all require actually being a party to that specific pairing.
      // Read stays open to everyone, same as the records themselves.
      match /matches/{foundReportId} {
        allow read: if signedIn();
        allow write: if signedIn() && (
          isEditorOrAdmin() ||
          get(/databases/$(database)/documents/lostCases/$(caseId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/foundReports/$(foundReportId)).data.reportedByUid == request.auth.uid
        );
      }
    }

    // Collection-group read access for "matches" (see getMatchesForFoundReport
    // in matchingApi.js, which queries across every lostCases/*/matches
    // subcollection at once instead of one read per lost case). A rule
    // nested under a specific parent path (lostCases/{caseId}/matches/{id}
    // above) only ever covers reads scoped to that one case's own
    // subcollection - Firestore requires this separate {path=**} wildcard
    // rule to authorize a query that spans every "matches" subcollection
    // regardless of which lost case it's under. Read-only here; writes to
    // an individual match still go through the rule above.
    match /{path=**}/matches/{matchId} {
      allow read: if signedIn();
    }

    // hasVisualMatch is the same denormalized counter carve-out as
    // lostCases' matchCount etc. above. The closure carve-out mirrors
    // lostCases' own: only when closureReason is 'system_match_closed' AND
    // a real match under the named lost case actually references this
    // found report AND the requester owns that lost case - so a lost
    // case's owner can close out the found report on the other end of
    // their match too.
    match /foundReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isEditorOrAdmin() ||
        resource.data.reportedByUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVisualMatch']) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'closureDate', 'closureReason', 'closedBy', 'closingComment',
            'closedViaLostCaseId', 'updatedAt'
          ]) &&
          request.resource.data.closureReason == 'system_match_closed' &&
          exists(/databases/$(database)/documents/lostCases/$(request.resource.data.closedViaLostCaseId)/matches/$(reportId)) &&
          get(/databases/$(database)/documents/lostCases/$(request.resource.data.closedViaLostCaseId)).data.ownerId == request.auth.uid
        )
      );
      allow delete: if signedIn() && (isEditorOrAdmin() || resource.data.reportedByUid == request.auth.uid);
    }

    // Shared config (match weights, the customizable color list, the
    // about-dialog text) - read by everyone (forms/matching/AboutDialog use
    // these), written only from the admin-only settings screens that edit
    // them (AboutDialog's edit control included).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Sequential per-type record numbers (LC/LD/FC/FD, see
    // recordNumberApi.js) - a shared counter incremented by whoever creates
    // a lost case or found report, which can be any signed-in user, not
    // just an admin, so this can't reuse the admin-only /config rule above.
    match /recordCounters/{type} {
      allow read, write: if signedIn();
    }

    // Feedback conversation threads (see feedback/feedbackApi.js) - a
    // regular user can only see/reply to their own threads; an admin can
    // see and reply to everyone's, since that's the whole point of an
    // admin inbox. Creating a thread always ties it to your own uid.
    match /feedbackThreads/{threadId} {
      allow read, update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
