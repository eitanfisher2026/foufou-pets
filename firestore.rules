rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'regular';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isEditorOrAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'editor');
    }

    // Settings (where roles get managed) is admin-only, which means nobody
    // could ever reach it to grant the very first admin - one known
    // identity is allowed to create its own profile doc as admin instead
    // of regular, mirroring the same check in usersApi.js. Everyone else
    // always starts REGULAR; only an existing admin can promote anyone
    // after that.
    function isBootstrapAdmin() {
      return request.auth.token.email == 'eitanfisher100@gmail.com';
    }

    // Everyone who has ever signed in gets a profile doc (see usersApi.js:
    // upsertUserOnLogin). Only an admin can change someone's role after
    // creation; a user can still update their own doc (lastLoginAt,
    // refreshed displayName/photoURL on each sign-in) as long as they
    // leave role untouched.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid &&
        (request.resource.data.role == 'regular' || (request.resource.data.role == 'admin' && isBootstrapAdmin()));
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Everyone can view every case (regular users included - "view all
    // records" is explicit) and create their own. Editing/deleting someone
    // else's case is editor/admin-only, EXCEPT the specific denormalized
    // fields a match-check writes back onto the case (matchCount etc.) -
    // "run the match for all" needs to write those on any case, not just
    // your own, without opening up the rest of the record. visualMatchCostUsd,
    // hasVisualMatch and importantMatchCount are the same story for the AI
    // photo-similarity check and per-match status counters (see
    // matchingApi.js) - both can fire while checking/reviewing matches
    // against someone else's lost case just as easily as your own.
    // status/closureDate/closureReason/closedBy/closingComment/updatedAt are
    // included too for the same reason as the /matches subcollection below
    // being open to everyone: marking a match CLOSED (a genuine "found!")
    // archives BOTH sides of the pair through this same open door - a found
    // report's own owner needs to be able to close out the lost case on the
    // other end of their match, not just editors/admins or that case's own
    // owner, or the single most important status a match can reach would be
    // the one action most people reviewing a match from their own side could
    // never actually take.
    match /lostCases/{caseId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isEditorOrAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'matchCount', 'newMatchCount', 'importantMatchCount', 'topMatchScore', 'lastCheckedAt',
          'visualMatchCostUsd', 'hasVisualMatch',
          'status', 'closureDate', 'closureReason', 'closedBy', 'closingComment', 'updatedAt'
        ])
      );
      allow delete: if signedIn() && (isEditorOrAdmin() || resource.data.ownerId == request.auth.uid);

      // Match results/status - who exactly may change a match's status is
      // still undecided (matching + archiving permissions are explicitly a
      // "refine later" item), so left open to any signed-in user for now.
      match /matches/{foundReportId} {
        allow read, write: if signedIn();
      }
    }

    // Collection-group read access for "matches" (see getMatchesForFoundReport
    // in matchingApi.js, which queries across every lostCases/*/matches
    // subcollection at once instead of one read per lost case). A rule
    // nested under a specific parent path (lostCases/{caseId}/matches/{id}
    // above) only ever covers reads scoped to that one case's own
    // subcollection - Firestore requires this separate {path=**} wildcard
    // rule to authorize a query that spans every "matches" subcollection
    // regardless of which lost case it's under. Read-only here; writes to
    // an individual match still go through the rule above.
    match /{path=**}/matches/{matchId} {
      allow read: if signedIn();
    }

    // hasVisualMatch is the same denormalized-field carve-out as
    // lostCases' matchCount etc. above - a match-check can set this on a
    // found report you don't own just as easily as on your own. The closure
    // fields are the same "closing a match archives both sides" carve-out
    // as lostCases' own closure fields - a lost case's owner needs to be
    // able to close out a found report on the other end of their match too.
    match /foundReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        isEditorOrAdmin() ||
        resource.data.reportedByUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hasVisualMatch', 'status', 'closureDate', 'closureReason', 'closedBy', 'closingComment', 'updatedAt'
        ])
      );
      allow delete: if signedIn() && (isEditorOrAdmin() || resource.data.reportedByUid == request.auth.uid);
    }

    // Shared config (match weights, the customizable color list, the
    // about-dialog text) - read by everyone (forms/matching/AboutDialog use
    // these), written only from the admin-only settings screens that edit
    // them (AboutDialog's edit control included).
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Sequential per-type record numbers (LC/LD/FC/FD, see
    // recordNumberApi.js) - a shared counter incremented by whoever creates
    // a lost case or found report, which can be any signed-in user, not
    // just an admin, so this can't reuse the admin-only /config rule above.
    match /recordCounters/{type} {
      allow read, write: if signedIn();
    }

    // Feedback conversation threads (see feedback/feedbackApi.js) - a
    // regular user can only see/reply to their own threads; an admin can
    // see and reply to everyone's, since that's the whole point of an
    // admin inbox. Creating a thread always ties it to your own uid.
    match /feedbackThreads/{threadId} {
      allow read, update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
